<Window x:Class="projecteKanban.UserManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projecteKanban"
        mc:Ignorable="d"
        Title="UserManager"
        Height="450"
        Width="800"
        Background="#F3F4F6">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestió d'Usuaris"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#374151"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,10,0">

                <ListBox x:Name="lbUsers"
                         DisplayMemberPath="Nom"
                         Margin="5"
                         FontSize="16"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Margin="10,0,0,0">

                <Button Content="Editar"
                        Width="120"
                        Padding="8,4"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        Click="EditWindow"/>

                <Button Content="Nou Usuari"
                        Width="120"
                        Padding="8,4"
                        Background="#10B981"
                        Foreground="White"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        Click="NewUser"/>

                <Button Content="Eliminar"
                        Width="120"
                        Padding="8,4"
                        Background="#EF4444"
                        Foreground="White"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        Click="DeleteUser"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>
