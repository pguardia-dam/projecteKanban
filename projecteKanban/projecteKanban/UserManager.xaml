<Window x:Class="projecteKanban.UserManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projecteKanban"
        mc:Ignorable="d"
        Title="UserManager" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Lista de usuarios -->
        <ListBox x:Name="lbUsers" Grid.Row="1" Height="350" Width="600" Margin="10,10,0,0" DisplayMemberPath="Nom" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Editar" HorizontalAlignment="Left" Margin="696,32,0,0" Grid.Row="1" VerticalAlignment="Top" Click="EditWindow" Width="72"/>
        <Button Content="Nou Usuari" HorizontalAlignment="Left" Margin="696,79,0,0" Grid.Row="1" VerticalAlignment="Top" Click="NewUser" Width="72"/>
        <Button Content="Eliminar" HorizontalAlignment="Left" Margin="696,130,0,0" Grid.Row="1" VerticalAlignment="Top" Click="DeleteUser" Width="72"/>

    </Grid>
</Window>