<UserControl x:Class="projecteKanban.TascaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220" MinHeight="120">

    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Margin="6">

        <StackPanel>

            <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,5">
                <Button x:Name="btnEditarTasca"
                        Content="Editar"
                        Padding="6,2"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        Margin="0,0,8,0"
                        Click="btnEditarTasca_Click"/>

                <Button x:Name="btnEliminarTasca"
                        Content="X"
                        Padding="6,2"
                        Background="#EF4444"
                        Foreground="White"
                        BorderBrush="#EF4444"
                        Click="btnEliminarTasca_Click"/>
            </WrapPanel>

            <TextBlock Text="{Binding CodiTasca}"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="#374151"/>

            <TextBlock Text="{Binding NomTasca}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,2,0,4"
                       Foreground="#111827"/>

            <TextBlock Text="{Binding Descripcio}"
                       TextWrapping="Wrap"
                       Foreground="#4B5563"
                       Margin="0,0,0,4"/>

            <TextBlock Text="{Binding Responsable}" Foreground="#6B7280"/>
            <TextBlock Text="{Binding DataInici}" Foreground="#6B7280"/>
            <TextBlock Text="{Binding DataFinal}" Foreground="#6B7280" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Content="⟵"
                        Width="40"
                        Padding="4"
                        Background="#E5E7EB"
                        BorderBrush="#D1D5DB"
                        Foreground="#374151"
                        Margin="0,0,10,0"
                        Click="btnLeft"/>

                <Button Content="⟶"
                        Width="40"
                        Padding="4"
                        Background="#E5E7EB"
                        BorderBrush="#D1D5DB"
                        Foreground="#374151"
                        Click="btnRight"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
