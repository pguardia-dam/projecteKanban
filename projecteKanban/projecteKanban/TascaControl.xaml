<UserControl x:Class="projecteKanban.TascaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200" MinHeight="100">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
        <StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="btnEditarTasca" Content="Editar" HorizontalAlignment="Right" Margin="0,0,10,0" Click="btnEditarTasca_Click"/>
                <Button x:Name="btnEliminarTasca" Content="X" HorizontalAlignment="Right"  Click="btnEliminarTasca_Click"/>
            </WrapPanel>
            <TextBlock Text="{Binding CodiTasca}" FontWeight="Bold"/>
            <TextBlock Text="{Binding NomTasca}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Descripcio}" />
            <TextBlock Text="{Binding Responsable}" />
            <TextBlock Text="{Binding DataInici}" />
            <TextBlock Text="{Binding DataFinal}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="&lt;" Margin="0,0,150,0" Click="btnLeft"/>
                <Button Content="&gt;" Click="btnRight"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>