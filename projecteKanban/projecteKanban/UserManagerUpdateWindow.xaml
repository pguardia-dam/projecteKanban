<Window x:Class="projecteKanban.UserManagerUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projecteKanban"
        mc:Ignorable="d"
        Title="UserManagerUpdateWindow"
        Height="450"
        Width="400"
        Background="#F3F4F6">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFFFFF"
                CornerRadius="10"
                Padding="20"
                Margin="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Update"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#374151"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Nom" FontSize="16" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBox Name="nameInput"
                         Width="220"
                         Height="28"
                         Margin="0,0,0,20"
                         HorizontalAlignment="Center"/>

                <TextBlock Text="Contrasenya" FontSize="16" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <PasswordBox x:Name="passwdInput"
                             Width="220"
                             Height="28"
                             Margin="0,0,0,20"
                             HorizontalAlignment="Center"/>

                <TextBlock Text="Responsable" FontSize="16" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <CheckBox x:Name="responsableCheckBox"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>

                <Button Content="Guardar"
                        Width="140"
                        Padding="10,5"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderBrush="#4F46E5"
                        BorderThickness="1"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        Click="BtnGuardar"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
