<Window x:Class="projecteKanban.UserManagerUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projecteKanban"
        mc:Ignorable="d"
        Title="UserManagerUpdateWindow" Height="450" Width="400">
    <Grid>
        <Label HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="32">Update</Label>
        <StackPanel VerticalAlignment="Center">
            <Label HorizontalAlignment="Center">Nom</Label>
            <TextBox Name="nameInput" Width="200"></TextBox>
            <Label HorizontalAlignment="Center" Margin="0,40,0,0">Contrasenya</Label>
            <PasswordBox x:Name="passwdInput" Width="200"></PasswordBox>
            <Label HorizontalAlignment="Center" Margin="0,40,0,0">Responsable</Label>
            <CheckBox x:Name="responsableCheckBox" HorizontalAlignment="Center"></CheckBox>
            <Button Content="Guardar" Width="100" Margin="0,25,0,0" Click="BtnGuardar"></Button>
        </StackPanel>
    </Grid>
</Window>
