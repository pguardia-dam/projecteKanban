<Window x:Class="projecteKanban.NewTasca"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projecteKanban"
        mc:Ignorable="d"
        Title="NewTasca"
        Height="600"
        Width="900"
        Background="#F3F4F6">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" Padding="20" Margin="0,0,0,10">
            <TextBlock Text="Nova Tasca"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#374151"
                       HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Nom Tasca:" FontSize="20" Margin="0,0,0,5"/>
                    <TextBox x:Name="NomTascaTextBox" Width="270"/>

                    <TextBlock Text="Descripció:" FontSize="20" Margin="0,15,0,5"/>
                    <TextBox x:Name="DescripcioTextBox" Width="270" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Text="Data Inici:" FontSize="20" Margin="0,15,0,5"/>
                    <DatePicker x:Name="DataIniciPicker" Width="270"/>

                    <TextBlock Text="Data Entrega Provisional:" FontSize="20" Margin="0,15,0,5"/>
                    <DatePicker x:Name="DataEntregaPicker" Width="270"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Margin="20" VerticalAlignment="Top">
                <TextBlock Text="Prioritat:" FontSize="20" Margin="0,0,0,20"/>
                <RadioButton Name="UrgentRadioButton" Content="Urgent" Margin="0,0,0,10"/>
                <RadioButton Name="AltaRadioButton" Content="Alta" Margin="0,0,0,10"/>
                <RadioButton Name="MitjaRadioButton" Content="Mitja" Margin="0,0,0,10"/>
                <RadioButton Name="BaixaRadioButton" Content="Baixa" Margin="0,0,0,10"/>
                <RadioButton Name="OpcionalRadioButton" Content="Opcional/NA" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,20,0">
            <Button x:Name="CrearButton"
                    Content="Crear Tasca"
                    Width="160"
                    Padding="12,6"
                    Background="#4F46E5"
                    Foreground="White"
                    BorderBrush="#4F46E5"
                    BorderThickness="1"
                    FontSize="16"
                    Click="CrearTasca"/>
        </StackPanel>
    </Grid>
</Window>
